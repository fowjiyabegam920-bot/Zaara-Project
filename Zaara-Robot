// =====================================
// ZAARA ESP32 WELCOME ROBOT
// =====================================

// L298N
const int IN1 = 26;
const int IN2 = 27;
const int ENA = 25;
const int IN3 = 18;
const int IN4 = 19;
const int ENB = 23;

// HC-SR04
const int TRIG_PIN = 5;
const int ECHO_PIN = 34;

// Servo
const int SERVO_PIN = 13;
Servo scanner;

// MP3-TF-16P V3.0
HardwareSerial MP3Serial(2);
DFRobotDFPlayerMini player;
bool mp3Ready = false;

// Bluetooth Classic SPP
BluetoothSerial SerialBT;
bool bluetoothReady = false;

// Wi-Fi
const char* wifiName = "ZAARA_Robot";
const char* wifiPassword = "Welcome123";
WebServer server(80);

// Settings
const int STOP_DISTANCE = 40;
const int RESUME_DISTANCE = 60;
const int MANUAL_SAFE_DISTANCE = 20;

// Robot state
bool autoMode = true;
bool welcomePlayed = false;
bool robotStopped = true;
float lastDistance = -1;
String lastAction = "Starting";

// =====================================
// MOTOR CONTROL
// =====================================

void stopMotors() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
  digitalWrite(ENA, LOW);
  digitalWrite(ENB, LOW);

  robotStopped = true;
}

void forwardMotors() {
  digitalWrite(ENA, HIGH);
  digitalWrite(ENB, HIGH);
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);

  robotStopped = false;
}

void reverseMotors() {
  digitalWrite(ENA, HIGH);
  digitalWrite(ENB, HIGH);
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);

  robotStopped = false;
}

void turnLeft() {
  digitalWrite(ENA, HIGH);
  digitalWrite(ENB, HIGH);
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);

  robotStopped = false;
}

void turnRight() {
  digitalWrite(ENA, HIGH);
  digitalWrite(ENB, HIGH);
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);

  robotStopped = false;
}

// =====================================
// ULTRASONIC SENSOR
// =====================================

float getDistance() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(3);

  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  unsigned long duration =
      pulseIn(ECHO_PIN, HIGH, 30000);

  if (duration == 0) {
    return -1;
  }

  return duration * 0.0343 / 2.0;
}

// =====================================
// MP3 WELCOME MESSAGE
// SD card: /MP3/0001.mp3
// =====================================

void playWelcome() {
  if (mp3Ready) {
    player.playMp3Folder(1);
    lastAction = "Welcome audio requested";
    Serial.println("[AUDIO] Playing 0001.mp3");
  } else {
    Serial.println("[AUDIO] MP3 is not ready");
    lastAction = "MP3 unavailable";
  }
}

// =====================================
// COMMAND HANDLER
// =====================================

void handleCommand(char command) {
  if (command >= 'a' && command <= 'z') {
    command -= 32;
  }

  Serial.print("[COMMAND] ");
  Serial.println(command);

  switch (command) {
    case 'A':
      autoMode = true;
      welcomePlayed = false;
      lastAction = "Automatic mode";
      Serial.println("[MODE] AUTO");
      break;

    case 'M':
      autoMode = false;
      stopMotors();
      lastAction = "Manual mode";
      Serial.println("[MODE] MANUAL");
      break;

    case 'F':
      autoMode = false;

      if (lastDistance > 0 &&
          lastDistance <= MANUAL_SAFE_DISTANCE) {
        stopMotors();
        lastAction = "Forward blocked: obstacle";
        Serial.println("[SAFETY] Object too close");
      } else if (lastDistance < 0) {
        stopMotors();
        lastAction = "Forward blocked: no sensor echo";
        Serial.println("[SAFETY] Sensor reading unavailable");
      } else {
        forwardMotors();
        lastAction = "Forward";
        Serial.println("[MOTOR] FORWARD");
      }
      break;

    case 'B':
      autoMode = false;
      reverseMotors();
      lastAction = "Reverse";
      Serial.println("[MOTOR] REVERSE");
      break;

    case 'L':
      autoMode = false;
      turnLeft();
      lastAction = "Left";
      Serial.println("[MOTOR] LEFT");
      break;

    case 'R':
      autoMode = false;
      turnRight();
      lastAction = "Right";
      Serial.println("[MOTOR] RIGHT");
      break;

    case 'S':
      autoMode = false;
      stopMotors();
      lastAction = "Stopped";
      Serial.println("[MOTOR] STOP");
      break;

    case 'W':
      playWelcome();
      break;

    default:
      Serial.println(
        "[HELP] Commands: A M F B L R S W"
      );
      break;
  }
}

