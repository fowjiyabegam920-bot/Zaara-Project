void setupWiFi() {
  WiFi.mode(WIFI_AP);

  if (WiFi.softAP(wifiName, wifiPassword)) {
    Serial.println("[WIFI] Access point started");
    Serial.print("[WIFI] Network: ");
    Serial.println(wifiName);
    Serial.print("[WIFI] Open http://");
    Serial.println(WiFi.softAPIP());
  } else {
    Serial.println("[WIFI] Access point failed");
  }

  server.on("/", []() {
    server.send_P(200, "text/html", webpage);
  });

  server.on("/cmd", []() {
    if (server.hasArg("c") && server.arg("c").length()) {
      handleCommand(server.arg("c")[0]);
    }
    server.send(200, "text/plain",
                "Action: " + lastAction);
  });

  server.on("/status", []() {
    String s = "Mode: ";
    s += autoMode ? "AUTO" : "MANUAL";
    s += " | Distance: ";

    if (lastDistance < 0) {
      s += "No echo";
    } else {
      s += String(lastDistance, 1) + " cm";
    }

    s += " | Action: " + lastAction;
    server.send(200, "text/plain", s);
  });

  server.begin();
  Serial.println("[WIFI] Web server ready");
}

// =====================================
// SETUP
// =====================================

void setup() {
  Serial.begin(115200);
  delay(1200);

  Serial.println();
  Serial.println("================================");
  Serial.println("     ZAARA WELCOME ROBOT");
  Serial.println("================================");

  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(ENA, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(ENB, OUTPUT);
  stopMotors();

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  digitalWrite(TRIG_PIN, LOW);

  scanner.setPeriodHertz(50);
  scanner.attach(SERVO_PIN, 500, 2400);
  scanner.write(90);

  Serial.println("[SENSOR] Ultrasonic initialized");

  // MP3 startup
  MP3Serial.begin(9600, SERIAL_8N1, 16, 17);
  delay(500);

  Serial.println("[AUDIO] Checking MP3 module...");

  if (player.begin(MP3Serial)) {
    mp3Ready = true;
    player.volume(25);
    Serial.println("[AUDIO] MP3 ready");
  } else {
    Serial.println("[AUDIO] MP3 not detected");
  }

  // Bluetooth startup with diagnostics
  Serial.println("[BT] Starting Bluetooth Classic...");

  if (SerialBT.begin("ZAARA")) {
    bluetoothReady = true;
    Serial.println("[BT] STARTED SUCCESSFULLY");
    Serial.println("[BT] Device name: ZAARA");
    Serial.println("[BT] Pair from Android Bluetooth settings");
    Serial.println("[BT] Then connect using a serial terminal app");
  } else {
    bluetoothReady = false;
    Serial.println("[BT] START FAILED");
    Serial.println("[BT] Check board compatibility");
  }

  setupWiFi();

  Serial.println("--------------------------------");
  Serial.println("[READY] Robot initialization complete");
  Serial.println("[SERIAL] Send A/M/F/B/L/R/S/W");
  Serial.println("[WIFI] Phone network: ZAARA_Robot");
  Serial.println("[WIFI] Address: http://192.168.4.1");
  Serial.println("================================");

  autoMode = true;
}

// =====================================
// MAIN LOOP
// =====================================

void loop() {
  server.handleClient();

  // Commands typed in Serial Monitor
  while (Serial.available()) {
    char c = Serial.read();
    if (c != '\n' && c != '\r') {
      handleCommand(c);
    }
  }

  // Commands received over Bluetooth
  while (bluetoothReady && SerialBT.available()) {
    char c = SerialBT.read();

    if (c != '\n' && c != '\r' && c != '\t') {
      Serial.print("[BT RX] Received: ");
      Serial.println(c);

      handleCommand(c);

      SerialBT.print("ZAARA action: ");
      SerialBT.println(lastAction);
    }
  }

  // Read distance regularly
  lastDistance = getDistance();

  Serial.print("[SENSOR] Distance: ");
  if (lastDistance < 0) {
    Serial.print("NO ECHO");
  } else {
    Serial.print(lastDistance, 1);
    Serial.print(" cm");
  }

  Serial.print(" | Mode: ");
  Serial.print(autoMode ? "AUTO" : "MANUAL");

  if (autoMode) {
    // Fail safe: no echo means stop
    if (lastDistance < 0) {
      stopMotors();
      lastAction = "Stopped: sensor no echo";
      Serial.println(" | ACTION: STOP - NO ECHO");
    }
    else if (lastDistance <= STOP_DISTANCE) {
      stopMotors();
      lastAction = "Object detected - STOP";
      Serial.println(" | ACTION: STOP - OBJECT");

      if (!welcomePlayed) {
        playWelcome();
        welcomePlayed = true;
      }
    }
    else if (lastDistance >= RESUME_DISTANCE) {
      welcomePlayed = false;
      forwardMotors();
      lastAction = "Path clear - FORWARD";
      Serial.println(" | ACTION: FORWARD");
    }
    else {
      Serial.print(" | ACTION: ");
      Serial.println(robotStopped ? "WAITING" : "CONTINUE");
    }
  } else {
    Serial.print(" | ACTION: ");
    Serial.println(lastAction);
  }

  delay(300);
}
